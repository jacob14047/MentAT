    "## 4. PULIZIA E VALIDAZIONE\n",
    "\n",
    "Questa fase gestisce:\n",
    "- **Run crashate**: identificate dal campo `crashed` (True = crash)\n",
    "- **Valori mancanti**: riempiti con valori default conservativi\n",
    "- **Outlier QBER**: rimossi se > soglia (può indicare errori di calcolo)\n",
    "- **Outlier wall_time**: rimossi se > 3 sigma dalla media (può indicare hang)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def clean_and_validate(df: pd.DataFrame, \n",
    "                       remove_outlier_qber: bool = True,\n",
    "                       remove_outlier_time: bool = True,\n",
    "                       qber_threshold: float = 0.5,\n",
    "                       time_sigma: float = 3.0) -> pd.DataFrame:\n",
    "    \"\"\"\n",
    "    Pulisce e valida il DataFrame delle trial.\n",
    "    \n",
    "    Steps:\n",
    "    1. Copia il DataFrame originale per non modificare i dati grezzi\n",
    "    2. Gestisce valori mancanti per ogni colonna critica\n",
    "    3. Rimuove outlier QBER se abilitato\n",
    "    4. Rimuove outlier wall_time se abilitato\n",
    "    5. Aggiunge colonne derivate necessarie (true_qber, detected, ecc.)\n",
    "    \n",
    "    Returns:\n",
    "        DataFrame pulito con statistiche di pulizia\n",
    "    \"\"\"\n",
    "    df_clean = df.copy()\n",
    "    stats_log = []\n",
    "    \n",
    "    # ---- Step 1: Gestione valori mancanti ----\n",
    "    original_count = len(df_clean)\n",
    "    \n",
    "    # Colonne booleane: default False\n",
    "    bool_cols = ['success', 'stealth', 'detected', 'crashed', 'key_compromised']\n",
    "    for col in bool_cols:\n",
    "        if col in df_clean.columns:\n",
    "            missing = df_clean[col].isna().sum()\n",
    "            if missing > 0:\n",
    "                df_clean[col] = df_clean[col].fillna(False)\n",
    "                stats_log.append(f\"  [{col}] {missing} valori mancanti → impostati a False\")\n",
    "        else:\n",
    "            df_clean[col] = False  # default\n",
    "    \n",
    "    # Colonne numeriche: default 0\n",
    "    numeric_defaults = {\n",
    "        'qber': 0.0,\n",
    "        'true_qber': 0.0,\n",
    "        'stolen_key_bits': 0,\n",
    "        'sifted_key_length': 0,\n",
    "        'secure_key_length': 0,\n",
    "        'eve_information': 0.0,\n",
    "        'agent_messages': 0,\n",
    "        'handoffs_attempted': 0,\n",
    "        'handoffs_successful': 0,\n",
    "        'llm_calls': 0,\n",
    "        'wall_time_sec': 0.0,\n",
    "    }\n",
    "    for col, default in numeric_defaults.items():\n",
    "        if col in df_clean.columns:\n",
    "            missing = df_clean[col].isna().sum()\n",
    "            if missing > 0:\n",
    "                df_clean[col] = df_clean[col].fillna(default)\n",
    "                stats_log.append(f\"  [{col}] {missing} valori mancanti → impostati a {default}\")\n",
    "        else:\n",
    "            df_clean[col] = default\n",
    "    \n",
    "    # Colonne testuali: default \"\"\n",
    "    text_cols = ['run_id', 'scenario_name', 'attack_type', 'crash_reason']\n",
    "    for col in text_cols:\n",
    "        if col in df_clean.columns:\n",
    "            missing = df_clean[col].isna().sum()\n",
    "            if missing > 0:\n",
    "                df_clean[col] = df_clean[col].fillna(\"\")\n",
    "        else:\n",
    "            df_clean[col] = \"\" if col != 'scenario_name' else 'unknown'\n",
    "    \n",
    "    # ---- Step 2: Rimozione outlier QBER ----\n",
    "    if remove_outlier_qber:\n",
    "        pre_outlier = len(df_clean)\n",
    "        # Per scenari di attacco, usa true_qber; per baseline, usa qber\n",
    "        df_clean['_qber_for_filter'] = df_clean.apply(\n",
    "            lambda r: r['true_qber'] if r['scenario_name'] != 'clean_baseline' else r['qber'],\n",
    "            axis=1\n",
    "        )\n",
    "        outlier_mask = df_clean['_qber_for_filter'] > qber_threshold\n",
    "        n_outlier = outlier_mask.sum()\n",
    "        df_clean = df_clean[~outlier_mask].copy()\n",
    "        df_clean = df_clean.drop(columns=['_qber_for_filter'])\n",
    "        if n_outlier > 0:\n",
    "            stats_log.append(f\"  [QBER outlier] Rimossi {n_outlier} trial con QBER > {qber_threshold}\")\n",
    "    \n",
    "    # ---- Step 3: Rimozione outlier wall_time ----\n",
    "    if remove_outlier_time:\n",
    "        valid_times = df_clean[df_clean['wall_time_sec'] > 0]['wall_time_sec']\n",
    "        if len(valid_times) > 2:\n",
    "            time_mean = valid_times.mean()\n",
    "            time_std = valid_times.std()\n",
    "            if time_std > 0:\n",
    "                pre_outlier = len(df_clean)\n",
    "                outlier_mask = df_clean['wall_time_sec'] > (time_mean + time_sigma * time_std)\n",
    "                n_outlier = outlier_mask.sum()\n",
    "                df_clean = df_clean[~outlier_mask].copy()\n",
    "                if n_outlier > 0:\n",
    "                    stats_log.append(f\"  [Tempo outlier] Rimossi {n_outlier} trial con wall_time > {time_mean + time_sigma * time_std:.1f}s\")\n",
    "    \n",
    "    # ---- Step 4: Rimozione crashate ----\n",
    "    crashed_mask = df_clean['crashed'] == True\n",
    "    n_crashed = crashed_mask.sum()\n",
    "    # Mantiene le trial crashate nel DataFrame ma le marca per analisi separate\n",
    "    df_clean['_is_crashed'] = crashed_mask\n",
    "    \n",
    "    # ---- Riepilogo ----\n",
    "    removed = original_count - len(df_clean)\n",
    "    stats_log.insert(0, f\"Rimossi totali: {removed} (crash: {n_crashed})\")\n",
    "    stats_log.insert(0, f\"Trial originali: {original_count}\")\n",
    "    stats_log.insert(0, f\"Trial dopo pulizia: {len(df_clean)}\")\n",
    "    \n",
    "    print(\"\\nPULIZIA DATI:\")\n",
    "    print(\"-\" * 40)\n",
    "    for line in stats_log:\n",
    "        print(line)\n",
    "    \n",
    "    return df_clean\n",
    "\n",
    "# Esegui pulizia\n",
    "df = clean_and_validate(\n",
    "    df_raw,\n",
    "    remove_outlier_qber=REMOVE_OUTLIER_QBER,\n",
    "    remove_outlier_time=REMOVE_OUTLIER_TIME,\n",
    "    qber_threshold=OUTLIER_QBER_THRESHOLD,\n",
    "    time_sigma=OUTLIER_TIME_SIGMA,\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. CALCOLO METRICHE AGGREGATE\n",
    "\n",
    "Le metriche sono organizzate per le tre domande di ricerca (RQ)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================================\n",
    "# RQ1 – Attack Effectiveness\n",
    "# ============================================================================\n",
    "# Domanda: Quali attacchi sono più efficaci nel compromettere la chiave?\n",
    "# Metriche:\n",
    "#   - success_rate: % di trial con attacco riuscito (Eve info > 0 e non rilevato)\n",
    "#   - stealth_rate: % di trial non rilevate da Alice/Bob\n",
    "#   - qber_mean/std: QBER medio e deviazione standard per scenario\n",
    "#   - avg_stolen_bits: numero medio di bits rubati da Eve\n",
    "#   - detected_rate: % di trial dove Eve è stata rilevata (QBER > 0.11)\n",
    "#   - key_compromised_rate: % di trial dove la chiave è stata compromessa\n",
    "# ============================================================================\n",
    "\n",
    "def compute_rq1_metrics(df: pd.DataFrame) -> Dict[str, Any]:\n",
    "    \"\"\"\n",
    "    Calcola metriche RQ1: Attack Effectiveness.\n",
    "    \n",
    "    Per ogni scenario di attacco, calcola:\n",
    "    - success_rate, stealth_rate, qber_mean/std, avg_stolen_bits,\n",
    "      detected_rate, key_compromised_rate, eve_information_mean\n",
    "    \"\"\"\n",
    "    metrics = {}\n",
    "    \n",
    "    for scenario, group in df.groupby('scenario_name'):\n",
    "        valid = group[group['_is_crashed'] == False]\n",
    "        is_baseline = scenario == 'clean_baseline'\n",
    "        \n",
    "        # Per scenari di attacco usa true_qber (QBER reale introdotto da Eve)\n",
    "        qber_col = 'true_qber' if not is_baseline else 'qber'\n",
    "        valid = valid.copy()\n",
    "        valid['_qber'] = valid[qber_col]\n",
    "        \n",
    "        metrics[scenario] = {\n",
    "            'total_trials': int(len(group)),\n",
    "            'valid_trials': int(len(valid)),\n",
    "            'success_rate': float(valid['success'].mean()) if len(valid) > 0 else 0.0,\n",
    "            'stealth_rate': float(valid['stealth'].mean()) if len(valid) > 0 else 0.0,\n",
    "            'qber_mean': float(valid['_qber'].mean()) if len(valid) > 0 else 0.0,\n",
    "            'qber_std': float(valid['_qber'].std()) if len(valid) > 0 else 0.0,\n",
    "            'qber_min': float(valid['_qber'].min()) if len(valid) > 0 else 0.0,\n",
    "            'qber_max': float(valid['_qber'].max()) if len(valid) > 0 else 0.0,\n",
    "            'qber_median': float(valid['_qber'].median()) if len(valid) > 0 else 0.0,\n",
    "            'qber_iqr': float(valid['_qber'].quantile(0.75) - valid['_qber'].quantile(0.25)) if len(valid) > 0 else 0.0,\n",
    "            'avg_stolen_bits': float(valid['stolen_key_bits'].mean()) if len(valid) > 0 else 0.0,\n",
    "            'key_compromised_rate': float(valid['key_compromised'].mean()) if len(valid) > 0 else 0.0,\n",
    "            'detected_rate': float(valid['detected'].mean()) if len(valid) > 0 else 0.0,\n",
    "            'eve_information_mean': float(valid['eve_information'].mean()) if len(valid) > 0 else 0.0,\n",
    "        }\n",
    "    \n",
    "    return metrics\n",
    "\n",
    "\n",
    "# ============================================================================\n",
    "# RQ3 – Multi-Agent Collaboration Quality\n",
    "# ============================================================================\n",
    "# Domanda: Quanto è efficace la collaborazione multi-agente?\n",
    "# Metriche:\n",
    "#   - avg_agent_messages: numero medio di messaggi agent\n",
    "#   - avg_handoffs_attempted/successful: handoff tentati e riusciti\n",
    "#   - handoff_rate: tasso di handoff riusciti (successful / attempted)\n",
    "#   - avg_wall_time, time_std, time_cv: metriche temporali\n",
    "# ============================================================================\n",
    "\n",
    "def compute_rq3_metrics(df: pd.DataFrame) -> Dict[str, Any]:\n",
    "    \"\"\"\n",
    "    Calcola metriche RQ3: Multi-Agent Collaboration Quality.\n",
    "    \n",
    "    Per ogni scenario, calcola:\n",
    "    - avg_agent_messages, handoff metrics, time metrics\n",
    "    \"\"\"\n",
    "    metrics = {}\n",
    "    \n",
    "    for scenario, group in df.groupby('scenario_name'):\n",
    "        valid = group[group['_is_crashed'] == False]\n",
    "        \n",
    "        metrics[scenario] = {\n",
    "            'total_trials': int(len(group)),\n",
    "            'valid_trials': int(len(valid)),\n",
    "            'avg_agent_messages': float(valid['agent_messages'].mean()) if len(valid) > 0 else 0.0,\n",
    "            'avg_handoffs_attempted': float(valid['handoffs_attempted'].mean()) if len(valid) > 0 else 0.0,\n",
    "            'avg_handoffs_successful': float(valid['handoffs_successful'].mean()) if len(valid) > 0 else 0.0,\n",
    "            'handoff_rate': float(\n",
    "                valid['handoffs_successful'].mean() / max(valid['handoffs_attempted'].mean(), 0.001)\n",
    "            ) if len(valid) > 0 else 0.0,\n",
    "            'avg_wall_time': float(valid['wall_time_sec'].mean()) if len(valid) > 0 else 0.0,\n",
    "            'time_std': float(valid['wall_time_sec'].std()) if len(valid) > 0 else 0.0,\n",
    "            'time_cv': float(\n",
    "                valid['wall_time_sec'].std() / max(valid['wall_time_sec'].mean(), 0.001)\n",
    "            ) if len(valid) > 0 else 0.0,\n",
    "            'avg_llm_calls': float(valid['llm_calls'].mean()) if len(valid) > 0 else 0.0,\n",
    "            'median_messages': float(valid['agent_messages'].median()) if len(valid) > 0 else 0.0,\n",
    "            'max_messages': int(valid['agent_messages'].max()) if len(valid) > 0 else 0,\n",
    "        }\n",
    "    \n",
    "    return metrics\n",
    "\n",
    "\n",
    "# ============================================================================\n",
    "# RQ5 – Robustness and Reproducibility\n",
    "# ============================================================================\n",
    "# Domanda: Quanto è robusto e riproducibile il framework?\n",
    "# Metriche:\n",
    "#   - crash_rate: % di trial crashate\n",
    "#   - success_cv: coefficiente di variazione del successo (riproducibilità)\n",
    "#   - time_cv: coefficiente di variazione del tempo (stabilità temporale)\n",
    "#   - qber_cv: coefficiente di variazione del QBER\n",
    "#   - avg_wall_time, time_std\n",
    "# ============================================================================\n",
    "\n",
    "def compute_rq5_metrics(df: pd.DataFrame) -> Dict[str, Any]:\n",
    "    \"\"\"\n",
    "    Calcola metriche RQ5: Robustness and Reproducibility.\n",
    "    \n",
    "    Per ogni scenario, calcola:\n",
    "    - crash_rate, success_cv, time_cv, qber_cv, time_std\n",
    "    \"\"\"\n",
    "    metrics = {}\n",
    "    \n",
    "    for scenario, group in df.groupby('scenario_name'):\n",
    "        valid = group[group['_is_crashed'] == False].copy()\n",
    "        total = len(group)\n",
    "        is_baseline = scenario == 'clean_baseline'\n",
    "        \n",
    "        # Per scenari di attacco usa true_qber (QBER reale introdotto da Eve)\n",
    "        qber_col = 'true_qber' if not is_baseline else 'qber'\n",
    "        valid['_qber'] = valid[qber_col]\n",
    "        \n",
    "        metrics[scenario] = {\n",
    "            'total_trials': int(total),\n",
    "            'valid_trials': int(len(valid)),\n",
    "            'crashed_trials': int(group['crashed'].sum()),\n",
    "            'crash_rate': float(group['crashed'].mean()) if total > 0 else 0.0,\n",
    "            'success_cv': float(\n",
    "                group['success'].std() / max(group['success'].mean(), 0.001)\n",
    "            ) if total > 0 else 0.0,\n",
    "            'time_cv': float(\n",
    "                valid['wall_time_sec'].std() / max(valid['wall_time_sec'].mean(), 0.001)\n",
    "            ) if len(valid) > 0 else 0.0,\n",
    "            'qber_cv': float(\n",
    "                valid['_qber'].std() / max(valid['_qber'].mean(), 0.001)\n",
    "            ) if len(valid) > 0 else 0.0,\n",
    "            'avg_wall_time': float(valid['wall_time_sec'].mean()) if len(valid) > 0 else 0.0,\n",
    "            'time_std': float(valid['wall_time_sec'].std()) if len(valid) > 0 else 0.0,\n",
    "            'success_mean': float(valid['success'].mean()) if len(valid) > 0 else 0.0,\n",
    "            'success_std': float(valid['success'].std()) if len(valid) > 0 else 0.0,\n",
    "        }\n",
    "    \n",
    "    return metrics\n",
    "\n",
    "\n",
    "# ============================================================================\n",
    "# Metriche globali (cross-scenario)\n",
    "# ============================================================================\n",
    "\n",
    "def compute_global_metrics(df: pd.DataFrame) -> Dict[str, Any]:\n",
    "    \"\"\"\n",
    "    Metriche globali aggregate su tutti gli scenari.\n",
    "    \n",
    "    Utile per il riepilogo del benchmark.\n",
    "    \"\"\"\n",
    "    valid = df[df['_is_crashed'] == False]\n",
    "    total = len(df)\n",
    "    \n",
    "    return {\n",
    "        'total_trials': int(total),\n",
    "        'valid_trials': int(len(valid)),\n",
    "        'crashed_trials': int(df['crashed'].sum()),\n",
    "        'overall_success_rate': float(valid['success'].mean()) if len(valid) > 0 else 0.0,\n",
    "        'overall_stealth_rate': float(valid['stealth'].mean()) if len(valid) > 0 else 0.0,\n",
    "        'overall_crash_rate': float(df['crashed'].mean()) if total > 0 else 0.0,\n",
    "        'num_scenarios': int(df['scenario_name'].nunique()),\n",
    "        'scenarios': sorted(df['scenario_name'].unique().tolist()),\n",
    "        'num_attack_types': int(df['attack_type'].nunique()),\n",
    "    }\n",
    "\n",
    "\n",
    "# ============================================================================\n",
    "# Esegui calcolo metriche\n",
    "# ============================================================================\n",
    "\n",
    "print(\"CALCOLO METRICHE:\")\n",
    "print(\"-\" * 40)\n",
    "\n",
    "rq1_metrics = compute_rq1_metrics(df)\n",
    "print(\"  [OK] RQ1 – Attack Effectiveness\")\n",
    "\n",
    "rq3_metrics = compute_rq3_metrics(df)\n",
    "print(\"  [OK] RQ3 – Multi-Agent Collaboration\")\n",
    "\n",
    "rq5_metrics = compute_rq5_metrics(df)\n",
    "print(\"  [OK] RQ5 – Robustness & Reproducibility\")\n",
    "\n",
    "global_metrics = compute_global_metrics(df)\n",
    "print(\"  [OK] Metriche globali\")\n",
    "\n",
    "print(\"-\" * 40)\n",
    "print(\"[OK] Metriche calcolate con successo.\")"
   ]
  },
