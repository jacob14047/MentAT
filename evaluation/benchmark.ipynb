    "## 3. CARICAMENTO DATI\n",
    "\n",
    "Carica i dati da `evaluation_results.jsonl` (una riga JSON per ogni trial).\n",
    "Se il file JSONL non esiste, prova il file JSON alternativo."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_evaluation_data(jsonl_path: Path, json_path: Optional[Path] = None) -> pd.DataFrame:\n",
    "    \"\"\"\n",
    "    Carica i dati di valutazione da file JSONL o JSON.\n",
    "    \n",
    "    JSONL: una riga = un record JSON (formato standard per log)\n",
    "    JSON: lista di record (formato fallback)\n",
    "    \n",
    "    Returns:\n",
    "        DataFrame con tutte le trial caricate\n",
    "    \"\"\"\n",
    "    df = pd.DataFrame()\n",
    "    \n",
    "    # Prova JSONL prima\n",
    "    if jsonl_path.exists():\n",
    "        print(f\"[INFO] Caricamento da JSONL: {jsonl_path}\")\n",
    "        records = []\n",
    "        with open(jsonl_path, 'r', encoding='utf-8') as f:\n",
    "            for line_num, line in enumerate(f, 1):\n",
    "                line = line.strip()\n",
    "                if not line:\n",
    "                    continue\n",
    "                try:\n",
    "                    record = json.loads(line)\n",
    "                    records.append(record)\n",
    "                except json.JSONDecodeError as e:\n",
    "                    print(f\"[WARNING] Riga {line_num}: errore JSON – {e}\")\n",
    "        if records:\n",
    "            df = pd.DataFrame(records)\n",
    "            print(f\"[OK] Caricate {len(df)} trial da JSONL\")\n",
    "            return df\n",
    "    \n",
    "    # Fallback: JSON\n",
    "    if json_path and json_path.exists():\n",
    "        print(f\"[INFO] Caricamento da JSON (fallback): {json_path}\")\n",
    "        with open(json_path, 'r', encoding='utf-8') as f:\n",
    "            data = json.load(f)\n",
    "        if isinstance(data, list):\n",
    "            df = pd.DataFrame(data)\n",
    "            print(f\"[OK] Caricate {len(df)} trial da JSON\")\n",
    "        elif isinstance(data, dict):\n",
    "            # Potrebbe essere un dict con chiavi come 'results', 'trials', ecc.\n",
    "            for key in ['results', 'trials', 'data', 'evaluation_results']:\n",
    "                if key in data and isinstance(data[key], list):\n",
    "                    df = pd.DataFrame(data[key])\n",
    "                    print(f\"[OK] Caricate {len(df)} trial da JSON (chiave: '{key}')\")\n",
    "                    return df\n",
    "            print(f\"[WARNING] JSON con struttura non standard. Chiavi: {list(data.keys())[:10]}\")\n",
    "            # Fallback: prendi il primo valore che è una lista\n",
    "            for key, val in data.items():\n",
    "                if isinstance(val, list) and len(val) > 0:\n",
    "                    df = pd.DataFrame(val)\n",
    "                    print(f\"[OK] Caricate {len(df)} trial da JSON (chiave: '{key}')\")\n",
    "                    return df\n",
    "    \n",
    "    return df\n",
    "\n",
    "# Carica dati\n",
    "df_raw = load_evaluation_data(DATA_FILE, DATA_FILE_ALT)\n",
    "\n",
    "if df_raw.empty:\n",
    "    print(\"\\n[ERRORE] Nessun dato caricato.\")\n",
    "    print(\"Assicurati che il file esista in:\")\n",
    "    print(f\"  {DATA_FILE}\")\n",
    "    print(f\"  {DATA_FILE_ALT}\")\n",
    "else:\n",
    "    print(f\"\\n[OK] Caricate {len(df_raw)} trial totali.\")\n",
    "    print(f\"[OK] Colonne: {list(df_raw.columns)}\")"
   ]
